{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const h=require('http'),f=require('fs'),p=require('path');const T={'.html':'text/html','.css':'text/css','.js':'text/javascript','.png':'image/png','.gif':'image/gif','.wav':'audio/wav','.mp3':'audio/mpeg'};h.createServer((q,r)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u==='/')u='/index.html';const fp=p.join(process.cwd(),u);f.stat(fp,(e,s)=>{if(e){r.writeHead(404);return r.end()}r.writeHead(200,{'Content-Type':T[p.extname(fp)]||'application/octet-stream','Content-Length':s.size});f.createReadStream(fp).pipe(r)})}).listen(5173)"],
      "port": 5173
    }
  ]
}
